# Variables de la función /api/lead.
# Se configuran en Vercel → Settings → Environment Variables (NO en un .env
# subido al repo). Este archivo es solo la lista de referencia.

# --- Google Sheet (registro de solicitudes) ---
# Despliega apps-script/lead-sheet.gs como aplicación web y pega aquí su URL /exec.
LEAD_SHEET_URL=
# El mismo texto secreto que el TOKEN dentro del Apps Script.
LEAD_SHEET_TOKEN=

# --- Correo (Resend — https://resend.com, gratis hasta 3000/mes) ---
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend. Para probar sin
# dominio propio: onboarding@resend.dev
LEAD_FROM_EMAIL="Estudio <hola@tu-dominio.com>"
# A dónde te llegan los avisos de solicitud.
LEAD_TO_EMAIL=cmassoweb@gmail.com
